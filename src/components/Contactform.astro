---
import "../styles/global.css";
---
<!-- amber-900 colour for visualisation of stuff -->
<div class="grid grid-cols-[45%_55%] gap-16 justify-center items-center text-white p-20 max-w-7xl mx-auto rounded-2xl">
    <div class="w-full">
    <img src="/contact-form-image.png" alt="Contact us" class="w-full">
    </div>
    <div class="w-full justify-self-center">
    <form class="gap-8 flex flex-col w-full px-8 py-6 bg-[#242424] rounded-2xl border border-zinc-800">
        <div class="flex flex-col w-full text-xl">
        <label for="name" class="py-3 text-xl">Name</label>
        <input type="text" name="name" placeholder="John Hackclub" class="border-2 py-2 rounded-md px-2 bg-zinc-800 border-slate-500" required>
        </div>

        <div class="flex flex-col w-full gap-2 text-xl">
        <label for="email">E-mail</label>
        <input type="email" name="email" placeholder="Johnhackclub@wack.club" class="border-2 py-2 rounded-md px-2 bg-zinc-800 border-slate-500" required>
        </div>

        <div class="flex flex-col w-full gap-2 text-xl">
        <label for="msg">Message</label>
        <textarea name="msg" placeholder="hi" rows="5" class="border-2 rounded-md py-2 px-2 bg-zinc-800 border-slate-500 focus:ring-2 focus:ring-slate-500"></textarea>
        </div>

        <div class="flex flex-col gap-2 w-full">
        <button type="submit" class="border-2 rounded-md text-xl px-4 py-4 bg-cyan-500 text-black border-zinc-700 hover:border-white hover:ring-2 ">Submit</button>
        </div>
    </form>
    </div>
</div>
