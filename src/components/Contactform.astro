---
import "../styles/global.css";
---
<!-- amber-900 colour for visualisation of stuff -->
<div class="container flex mx-auto px-4 items-center bg-yellow-900">
        

    <!-- <img src="/contact-us-img.png" alt="Ci=ontact us" class="w-1/2"> -->
    <form class=" gap-4 flex flex-col items-start w-1/2 p-8">
        <div class="flex flex-col w-3/5">
        <label for="name" class="py-3">Name</label>
        <input type="text" name="name" class="border-2 rounded-md px-4 bg-stone-100" required>
        </div>

        <div class="flex flex-col w-3/5 gap-2">
        <label for="email">E-mail</label>
        <input type="email" name="email" class="border-2 rounded-md px-4 bg-stone-100" required>
        </div>

        <div class="flex flex-col w-3/5 gap-2">
        <label for="msg">Message</label>
        <textarea name="msg" class="border-2 rounded-md px-4 bg-stone-100"></textarea>
        </div>

        <div class="flex flex-col gap-2">
        <button type="submit" class="border-2 rounded-md px-4 bg-stone-100">Submit</button>
        </div>
    </form>


</div>  