---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Products</title>
	</head>
	<body class="bg-black text-white">
		<Navbar />
		<div class="w-full bg-[#1e293b] px-8 py-2 flex flex-row justify-center text-center rounded-xs">
			We offer a range of products such as battery chargers and many
			more which can be designed however you want them to be in terms of
			size, shape and we also provide a service for designing custom PCBs.
		</div>
		<div class="grid grid-cols-2 bg-blackp py-4 px-8">
			<div><img src="/3D-Front.png" /></div>

			<div class="flex flex-col items-center justify-center align-center gap-2">
				<p class="text-4xl font-bold">DC-DC Converter</p>
				<p class="text-lg">A fixed 5 volt output buck Converter</p>
				<p class="text-2xl">35$</p>
				<button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 font-bold rounded-2xl">Buy Now</button>
			</div>
		</div>
		<!-- <hr class="py-2"> -->
		<div class="grid grid-cols-2 bg-black px-8">
			<div><img src="/PCB-shop.png" /></div>
			<div class="flex flex-col items-center justify-center gap-2">
				<p class="text-4xl font-bold">Custom PCB Design Service</p>
				<p class="text-lg">We design a custom PCB for you</p>
				<p class="text-xl">Starting from 20$</p>
				<button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 font-bold rounded-xl" onclick="window.location.href='contact'">contact for custom quote</button>
			</div>
		</div>
		<Footer></Footer>
	</body>
</html>
