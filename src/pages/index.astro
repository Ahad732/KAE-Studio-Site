---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Home</title>
	</head>
	<body class="bg-black text-white">
		<Navbar></Navbar>
		
		<div>
			<div class="grid grid-cols-2 w-full p-3 border-2 ">

				<div><img src="/scicalc.png" style="margin-bottom=100px"/></div>

				<div class="flex flex-col items-center justify-center">
					<p class="text-4xl">Scicalc</p>	
					<p class="text-lg py-1">This is a custom designed Scientific Calculator</p>

					<p class="text-sm">We have designed a custom Scientifc calculator based on the RP2350a mcu</p>
					<p class="text-sm">with custom firmware. It is inspired by texas instrument's ti-84 calculator</p>
					<a href="https://github.com/Ahad732/Scicalc" class="text-3xl text-blue-500 pt-2">Github</a>

				</div>
			</div>

			<div class="grid grid-cols-2 w-full p-3 border-2">

				<div class="flex flex-col items-center justify-center">  
					<p class="text-4xl">Spindle</p>
					<p class="text-lg py-1">A e-reader with a e-ink display</p>

					<p class="text-sm">Spindle is a e-reader inspired by the reading app kindle. It has </p>
					<p class="text-sm">a sd-card slot and iot connectivity to download or upload books </p>
					<p class="text-sm">from your phone or any other device</p>

					
					<a href="https://github.com/Ahad732/Spindle" class="text-blue-500 pt-2 text-3xl">Github</a>

			    </div>

				<div> <img src="/pcb-3d.png"/></div>

			</div>
			<div class="grid grid-cols-2 w-full p-3 border-2">

				<div><img src="/nssfc.png"/></div>

				<div class="flex flex-col items-center justify-center">
					<p class="text-4xl">NSSFC</p>
					<p class="text-lg py-1">Not So Simple Flight Controller</p>
					<p class="text-sm">Not So Simple Flight Controller is a Drone flight controller which runs on </p>
					<p class="text-sm">the stm32f405 mcu. It runs on betaflight firmware which is open-source!</p>

					
					<a href="https://github.com/Keyaan-07/NSSFC" class="text-blue-500 pt-2 text-3xl">Github</a>
				</div>
				
			</div>
		</div>
		<Footer></Footer>
	</body>
</html>
