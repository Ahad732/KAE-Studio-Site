---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Home</title>
	</head>
	<body class="bg-black text-white">
		<Navbar></Navbar>
		
		<div>
			<div class="grid grid-cols-2 w-full p-3 border-2 ">

				<div><img src="/3d-render-isometric.png" style="margin-bottom=100px"/></div>

				<div>
					<h1 class="flex justify-center">Scicalc</h1>	
					<h2 class="flex justify-center">This is a custom designed Scientific Calculator</h2>

					<h2 class="Center">
						We have designed a custom Scientifc calculator based on the RP2350a mcu 
					</h2>
					<h2 class="Center">with custom firmware. It is inspired by texas
						instrument's ti-84 calculator</h2>

						<h1 style="margin-top: 30px; text-align: center;" class="Github">
						<a href="https://github.com/Ahad732/Scicalc">Github</a></h1>

				</div>
			</div>

			<div class="grid grid-cols-2 w-full p-3 border-2">

				<div>  
					<h1 class="flex justify-center">Spindle</h1>
					<h2 class="flex justify-center">A e-reader with a e-ink display</h2>

					<h2 class="Center">Spindle is a e-reader inspired by the reading app kindle. It has </h2>
					<h2 class="Center">a sd-card slot and iot connectivity to download or upload books </h2>
					<h2 class="Center">from your phone or any other device</h2>

					<h1 style="margin-top: 30px; text-align: center;" class="Github">
					<a href="https://github.com/Ahad732/Spindle">Github</a></h1>

			    </div>

				<div> <img src="/pcb-3d.png"/></div>

			</div>
			<div class="grid grid-cols-2 w-full p-3 border-2">

				<div><img src="/PCB.png"/></div>

				<div><h1 class="flex justify-center">NSSFC</h1>
					<h2 class="flex justify-center ">Not So Simple Flight Controller</h2>
					<h2 class="Center">Not So Simple Flight Controller is a Drone flight controller which runs on </h2>
					<h2 class="Center">the stm32f405 mcu. It runs on betaflight firmware which is open-source!</h2>

					<h1 style="margin-top: 30px; text-align: center;" class="Github">
					<a href="https://github.com/Keyaan-07/NSSFC">Github</a></h1>
				</div>
				
			</div>
		</div>

	</body>
</html>
