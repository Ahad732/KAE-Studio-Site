---
import Navbar from "../components/Navbar.astro";
import styles from "../styles/global.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.icu" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Sign-Up</title>
    </head>
    <body class="bg-zinc-950">
        <Navbar/>
      
        <div class="w-full flex flex-col items-center justify-center text-white pt-[10vh]">
                <form action="submit" class="w-1/3 flex flex-col justify-center items-start bg-[#242424] p-8 rounded-xl gap-4">
                    <div class="flex flex-col text-lg gap-2 w-full">
                        <label for="firstName" class="">First Name</label>
                        <input type="text" name="firstName" required class="border-1 bg-[#333333] rounded-lg py-2 border-slate-500 w-full">
                    </div>
                    <div class="flex flex-col text-lg gap-2 w-full">
                        <label for="lastName">Last Name</label>
                        <input type="text" name="lastName" required class="border-1 border-slate-500 rounded-lg bg-[#333333] py-2 w-full">
                    </div>
                    <div class="flex flex-col text-lg gap-2 w-full">
                        <label for="email">Email</label>
                        <input type="email" name="email" required class="border-1 border-slate-500 rounded-lg bg-[#333333] py-2 w-full">
                    </div>
                    <div class="flex flex-col text-lg gap-2 w-full">
                        <label for="pwd">Password</label>
                        <input type="password" name="pwd" class="border-1 border-slate-500 rounded-lg bg-[#333333] py-2 w-full">
                    </div>
                    <div class="flex flex-col text-lg gap-2 w-full">
                        <label for="cpwd">Confirm Password</label>
                        <input type="password" name="cpwd" class="border-1 border-slate-500 rounded-lg bg-[#333333] py-2 w-full">
                    </div>
                    <div class="flex w-full justify-center py-4">
                        <button type="submit" class="bg-cyan-500 text-zinc-950 rounded-lg px-8 py-3  hover:bg-cyan-400">Create Account</button>
                    </div>
                    <div class=" flex w-full text-sm justify-center">
                        <p>Already have an account? <a href="/login" class="text-cyan-500">Login Here</a></p>
                    </div>
                </form>
        </div>
    </body>
</html>
